# App Runtime
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/covenant

# Alpaca Paper Trading & Market Data (Paper endpoints only)
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_MOCK_MODE=false
ALPACA_DATA_FEED=indicative
ALPACA_STOCK_DATA_FEED=iex
ALPACA_ALLOWED_UNDERLYINGS=SPY,QQQ
ALPACA_OPTIONS_LEVEL_REQUIRED=3

# Permits & Cryptography (Ed25519)
PERMIT_SIGNING_PRIVATE_KEY=
PERMIT_SIGNING_PUBLIC_KEY=
PERMIT_TTL_SECONDS=60
PERMIT_NONCE_NAMESPACE=covenant-paper

# Model Provider (Mandate drafting / explanation)
MODEL_PROVIDER=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_MS=30000

# Auth & Operations
APP_AUTH_SECRET=
CRON_SECRET=
KILL_SWITCH_CONFIRMATION=COVENANT_HALT

# Proof and audit (Lane B)
# Generate the Ed25519 pair with: npm run keygen
# PERMIT_SIGNING_PRIVATE_KEY is read by lib/permits/sign.ts and nothing else.
# The executor holds only the public half: it can verify, never mint.
COVENANT_CODE_REVISION=dev
PROPERTY_TEST_SEED=20260830
