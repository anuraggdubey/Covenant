# Covenant — environment template. Copy to .env.local and fill in.
# .gitignore excludes .env.* apart from this file. Never commit real values.
#
# PAPER TRADING ONLY. lib/env.ts refuses any non-paper Alpaca host at runtime.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Alpaca (paper) --------------------------------------------------------
# Read by exactly two files: lib/alpaca/client.ts (read path) and
# lib/execution/executor.ts (order write path). See IMPLEMENTATION.md §3.
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_DATA_FEED=indicative
ALPACA_ALLOWED_UNDERLYINGS=SPY,QQQ
ALPACA_OPTIONS_LEVEL_REQUIRED=3

# --- Permit signing --------------------------------------------------------
# Generate with:  npm run keygen
# The PRIVATE key is read by lib/permits/sign.ts and nothing else.
# The executor holds only the PUBLIC key: it can verify, never mint.
PERMIT_SIGNING_PRIVATE_KEY=
PERMIT_SIGNING_PUBLIC_KEY=
PERMIT_TTL_SECONDS=60
PERMIT_NONCE_NAMESPACE=covenant-paper

# --- Database (T-01, pending) ---------------------------------------------
DATABASE_URL=

# --- Model (Featherless, for mandate drafting) -----------------------------
MODEL_PROVIDER=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_MS=30000

# --- App -------------------------------------------------------------------
APP_AUTH_SECRET=
CRON_SECRET=
KILL_SWITCH_CONFIRMATION=COVENANT_HALT
COVENANT_CODE_REVISION=dev

# --- Tests -----------------------------------------------------------------
PROPERTY_TEST_SEED=20260830
